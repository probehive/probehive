FROM docker.io/library/node:24.18.0-bookworm@sha256:5711a0d445a1af54af9589066c646df387d1831a608226f4cd694fc59e745059 AS build

WORKDIR /src/web
COPY web/package.json web/package-lock.json web/.npmrc ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM docker.io/library/nginx:1.31.1-alpine@sha256:8b1e78743a03dbb2c95171cc58639fef29abc8816598e27fb910ed2e621e589a

USER root
RUN rm -rf /usr/share/nginx/html/* \
    && mkdir -p /usr/share/nginx/html \
    && chown -R 101:101 /usr/share/nginx/html
COPY --chown=101:101 deploy/compose/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=101:101 /src/web/dist/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8443
HEALTHCHECK --interval=10s --timeout=3s --retries=12 \
    CMD ["wget", "-q", "--no-check-certificate", "-O", "/dev/null", "https://127.0.0.1:8443/healthz"]
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
